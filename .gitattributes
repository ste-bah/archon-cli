# Reference: project-tasks/archon-fixes/agentshit/phase-0-prereqs/TASK-AGS-013.md
# Based on: tests/fixtures/baseline/cargo_test_list.txt (TASK-AGS-001 baseline),
#           tests/fixtures/agents/generated/ (TASK-AGS-004 fixtures),
#           scripts/*.sh (TASK-AGS-002/003/007 guard scripts)
#
# Ensures baseline + generated fixture + shell-script line endings are
# stable across Linux/macOS/Windows checkouts and marks generated
# fixture files so GitHub's linguist excludes them from language stats
# (and diffs collapse them by default).

# Baseline snapshots — plain text with stable LF endings.
tests/fixtures/baseline/*.txt text eol=lf

# Generated discovery fixtures (TASK-AGS-004 produces 300 agent files).
tests/fixtures/agents/generated/** linguist-generated=true

# Shell scripts — always LF regardless of checkout OS. A CRLF script fails at
# the shebang/`set -euo pipefail\r` line, so `bash scripts/lint/arch-lint.sh`
# exits non-zero on a Windows checkout and tc_arch_02/tc_arch_05 fail locally
# while Linux CI passes. `scripts/*.sh` matched only the top level -- a pattern
# containing a slash is anchored and `*` does not cross `/` -- which left
# scripts/lint/ and scripts/ci/ unpinned. Match on basename instead.
*.sh text eol=lf

# Golden-file fixtures are compared byte-for-byte, so their line endings must
# not vary by platform. Without this the archon-draft gauntlet goldens fail on
# a Windows checkout purely on 
, while passing on macOS and Linux CI.
crates/archon-draft/tests/fixtures/** text eol=lf

# Scripts embedded via include_str!. Unlike a string literal in a .rs file,
# include_str! does not normalise CRLF, so a Windows checkout would hand the
# prelude \r\n and break the "\n  };\n" section slicing in
# workflow_live_v3_prelude_review_tests.rs. The deliverable verifier is a
# python heredoc, where CRLF breaks the heredoc terminator and indentation.
src/command/*.js text eol=lf
src/command/*.sh text eol=lf

# Generated docs are asserted equal to the generator's output, which emits \n.
# Without this a Windows checkout fails generated_provider_capabilities_doc_
# matches_code on line endings alone, while macOS and Linux CI pass.
docs/generated/** text eol=lf
