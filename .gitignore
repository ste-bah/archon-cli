# Rust build output
/target/
# `.archon/*` rather than `.archon/`: git does not descend into an excluded
# directory, so a bare `.archon/` makes the negation below unreachable and the
# shipped hook config silently untracked.
.archon/*
!.archon/hooks.toml
# The rule above contains a slash, so git anchors it to the repo root. A test or
# CLI run started inside a crate directory creates its own `.archon/` there --
# `crates/archon-pipeline/.archon/doc-vector-store/` turned up in a commit this
# way -- and the anchored rule does not cover it.
crates/*/.archon/
artifacts/
**/*.rs.bk

# Node / Gradle / Swift build artifacts (SDK clients)
**/node_modules/
**/.gradle/
**/build/
**/.build/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local config overrides (never commit secrets or machine-local config)
config.local.toml
.archon/hooks.local.toml
.env
.env.*
!.env.example
.mcp.json

# Logs
*.log
logs/

# Packaging artifacts
dist/
!web/dist/
archon-*.tar.gz
archon-*.zip
.claude

# Coverage / profiling
lcov.info
*.profraw
*.profdata

# Dev-flow gate artifacts (local task tracking state)
.gates/
project-tasks/

# Scratch / test files
hello.txt

# Local documentation (not committed).
# Use /docs/* instead of /docs/ so that negated sub-paths below can be
# re-included (git cannot re-include children of a fully excluded parent).
/docs/*
# Exception: architectural guidelines are committed (REQ-FOR-D10 et al.)
!/docs/architecture/
!/docs/architecture/**
# Exception: coverage baseline snapshot (TUI-328 / NFR-TUI-QUAL-003).
!/docs/tui-coverage-baseline.json
# Exception: phase-3 modularization final report (TUI-329).
!/docs/tui-modularization-report.md
# Exception: user-facing documentation tree (README split, v0.1.28+).
!/docs/README.md
!/docs/trading-lab.md
!/docs/getting-started/
!/docs/getting-started/**
!/docs/reference/
!/docs/reference/**
!/docs/integrations/
!/docs/integrations/**
!/docs/cookbook/
!/docs/cookbook/**
# Exception: ingestion parity + device-layer design docs (Port #2).
!/docs/ingestion/
!/docs/ingestion/**
# Exception: dissertation-port overview / platform-agnostic / setup docs.
!/docs/dissertation-port/
!/docs/dissertation-port/**
!/docs/operations/
!/docs/operations/**
!/docs/maintenance/
!/docs/maintenance/**
!/docs/maintainability/
!/docs/maintainability/**
!/docs/development/
!/docs/development/**
!/docs/release-notes/
!/docs/release-notes/**
# Exception: screenshots referenced by the committed docs. Without this the
# markdown ships with fifteen image links that 404, because `git add` skips
# ignored paths silently and nothing warns that a tracked page points at an
# untracked file.
!/docs/images/
!/docs/images/**

# Local-only artifacts (not for VCS)
# Must stay below the /docs/architecture/ re-includes above — last match wins.
/docs/architecture/topology-engineering.md
/docs/architecture/overnight-plan.md
FORENSIC-TASK-DECOMPOSITION.yaml
*:Zone.Identifier
.archon/leann.db
.archon/learning.db/
.archon/archon-data.db*
.archon/cognitive/
.archon/learning-state.db*
crates/archon-tui/tests/snapshots/tui_snapshots__splash_empty_activity.snap.new
crates/archon-tui/tests/snapshots/tui_snapshots__splash_with_activity.snap.new
archon

# machine-specific Archon policy (real paths); template is policy.example.toml
.archon/policy.toml
.backups/
/parity-ref/  # portability copy of god-agent markdown_chunker.py for scripts/chunk_parity_check.py
__pycache__/
# FCDP golden fixtures derived from unpublished private research content. Kept local
# (data stays off the remote); transferred to other dev boxes out-of-band (scp/bundle).
# The dependent tests skip when these are absent; synthetic fixtures ship in-repo.
/crates/archon-draft/tests/fixtures/m6/

# Audit and rescue reports: working documents, never tracked.
# They cite findings that source comments reference by name, but nothing reads
# them at build or gate time -- the citations are prose, not dependencies.
reports/
